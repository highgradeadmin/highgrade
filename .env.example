# Server-side only. Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Supabase → Project Settings → API (URL + publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Max feedback requests per child per 24h (default 10)
FEEDBACK_DAILY_LIMIT=10

# Stripe (server-side only). Leave empty to turn billing off. Use sk_test_… while testing.
# Then run once: node --env-file=.env.local scripts/stripe-setup.mjs
STRIPE_SECRET_KEY=

# Fair use per family (all children together). Admins are exempt.
# The coach runs on Claude Haiku 5.5: about 7,000 tokens and $0.002 per feedback.
# 3,600,000 tokens is about 510 feedbacks a month (at most about $1 of Claude usage on the $4.99 plan).
FAMILY_DAILY_LIMIT=20
FAMILY_MONTHLY_TOKENS=3600000
